# Copy to .env.local. Local-only values; replace all secrets for deployment.
DATABASE_URL=postgresql://outguess:outguess@127.0.0.1:5434/outguess
PUBLIC_URL=http://localhost:3100
SESSION_SECRET=local-development-secret-replace-before-deploying
STAFF_PIN=4321
DEMO_MODE=1
# Set DEMO_MODE=0 only after importing approved content and consent.
# Verify the supplied daily prize quantities and activate the correct day in /staff.
ADSPARK_CONTACT_URL=https://www.adspark.ph/get-in-touch
# Optional override; the app defaults to AdSpark's supplied privacy-policy URL.
ADSPARK_PRIVACY_POLICY_URL=https://www.adspark.ph/privacy-policy
# Cloud Run: omit DATABASE_URL and set these runtime environment variables:
# INSTANCE_CONNECTION_NAME=project:region:instance
# DB_NAME=outguess
# DB_USER=outguess
# DB_PASSWORD=
# DB_POOL_MAX=5
